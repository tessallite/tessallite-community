# HTTPS redirect gate — three conditions checked:
#  1. DISABLE_HTTPS_REDIRECT is not set (empty / false / 0 = production)
#  2. The connection scheme is HTTP
#  3. No trusted TLS proxy has set X-Forwarded-Proto: https
# X-Forwarded-Proto is only honoured when TRUST_PROXY_HEADERS is set,
# preventing spoofing on direct-edge deployments.

map "${DISABLE_HTTPS_REDIRECT}" $redir_enabled {
    ""      1;
    "false" 1;
    "0"     1;
    default 0;
}

map "${TRUST_PROXY_HEADERS}:$http_x_forwarded_proto" $behind_tls_proxy {
    "true:https" 1;
    "1:https"    1;
    default      0;
}

server {
    listen ${LISTEN_PORT};
    listen 3443 ssl;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate /etc/nginx/certs/localhost.crt;
    ssl_certificate_key /etc/nginx/certs/localhost.key;

    # HTTPS redirect — "if + return" is a safe nginx pattern.
    # Skipped when: disabled by env var, already HTTPS, or behind a trusted TLS proxy.
    set $do_redir "$redir_enabled:$scheme:$behind_tls_proxy";
    if ($do_redir = "1:http:0") {
        return 301 https://$host$request_uri;
    }

    # HSTS — browsers ignore this over HTTP (RFC 6797), safe to include always
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 100M;
    proxy_http_version 1.1;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_ssl_server_name on;

    resolver ${RESOLVER} ipv6=off valid=30s;

    # XMLA endpoint — Excel MSOLAP requires WWW-Authenticate on 401
    location /api/v1/xmla {
        set $upstream_gateway ${GATEWAY_URL};
        proxy_set_header Host ${GATEWAY_HOST};
        proxy_pass $upstream_gateway;
        proxy_hide_header WWW-Authenticate;
        add_header WWW-Authenticate 'Basic realm="Analysis Services"' always;
    }

    # Agent endpoints (regex takes priority over /api/ prefix catch-all)
    location ~ ^/api/v1/projects/[^/]+/agent {
        set $upstream_agent ${AGENT_SERVICE_URL};
        proxy_set_header Host ${AGENT_SERVICE_HOST};
        proxy_pass $upstream_agent;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection "";
    }

    # Plugin execution — routes to query-router, not model-service
    location /api/v1/plugin/ {
        set $upstream_router ${QUERY_ROUTER_URL};
        proxy_set_header Host ${QUERY_ROUTER_HOST};
        proxy_pass $upstream_router;
    }

    # Headless query API — lives on query-router (F-030-10 / G-030-02).
    # Longest-prefix match wins over location /api/ so published
    # POST /api/v1/headless/query reaches the router, not model-service 404.
    location /api/v1/headless/ {
        set $upstream_router ${QUERY_ROUTER_URL};
        proxy_set_header Host ${QUERY_ROUTER_HOST};
        proxy_pass $upstream_router;
    }

    # Model-service
    location /api/ {
        set $upstream_model ${MODEL_SERVICE_URL};
        proxy_set_header Host ${MODEL_SERVICE_HOST};
        proxy_pass $upstream_model;
    }

    # ------------------------------------------------------------------
    # Per-service SPA proxy prefixes (Bug-7770 — fail closed).
    #
    # The SPA (frontend/src/api/apiBase.ts) reaches these backends
    # same-origin under "<prefix>/api/..." only. Each backend enforces its
    # own JWT-cookie auth on "/api/..." routes. The raw backend root,
    # however, also exposes UNAUTHENTICATED surface (FastAPI /docs,
    # /openapi.json, /redoc, /health, /metrics) that must NOT be public.
    #
    # So each prefix forwards ONLY its "<prefix>/api/" sub-path to the
    # backend and returns 404 for the bare prefix and every non-api path.
    # This closes the internal-API-surface disclosure while keeping the
    # authenticated SPA calls working. The gateway prefix is removed
    # entirely: the SPA reaches the gateway solely via /api/v1/xmla.
    # ------------------------------------------------------------------

    # nginx picks the LONGEST matching prefix, so "<prefix>/api/..." always
    # wins over the bare "<prefix>/" catch-all below it (regardless of order).
    location /query-router/api/ {
        set $upstream_router ${QUERY_ROUTER_URL};
        proxy_set_header Host ${QUERY_ROUTER_HOST};
        rewrite ^/query-router/(.*)$ /$1 break;
        proxy_pass $upstream_router;
    }
    location /query-router/ { return 404; }

    location /optimizer/api/ {
        set $upstream_optimizer ${OPTIMIZER_URL};
        proxy_set_header Host ${OPTIMIZER_HOST};
        rewrite ^/optimizer/(.*)$ /$1 break;
        proxy_pass $upstream_optimizer;
    }
    location /optimizer/ { return 404; }

    location /scheduler/api/ {
        set $upstream_scheduler ${SCHEDULER_URL};
        proxy_set_header Host ${SCHEDULER_HOST};
        rewrite ^/scheduler/(.*)$ /$1 break;
        proxy_pass $upstream_scheduler;
    }
    location /scheduler/ { return 404; }

    location /agent/api/ {
        set $upstream_agent ${AGENT_SERVICE_URL};
        proxy_set_header Host ${AGENT_SERVICE_HOST};
        rewrite ^/agent/(.*)$ /$1 break;
        proxy_pass $upstream_agent;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection "";
    }
    location /agent/ { return 404; }

    # The gateway is reached ONLY via /api/v1/xmla (above). Its raw proxy
    # prefix was removed (Bug-7770); block the path explicitly so it fails
    # closed with 404 instead of falling through to the SPA static handler.
    location /gateway/ { return 404; }

    # Prometheus metrics (nginx stub_status)
    location = /stub_status {
        stub_status;
        allow 172.16.0.0/12;
        allow 10.0.0.0/8;
        allow 192.168.0.0/16;
        allow 127.0.0.1;
        deny all;
    }

    # Process liveness (nginx is up). Serving readiness is location = /health.
    location = /liveness {
        default_type application/json;
        return 200 '{"status":"ok","service":"frontend"}';
    }

    # F-030-01 / F-105-12 / Bug-9365: SPA /health is serving-readiness, not
    # process liveness. njs fan-out ANDs model-service + query-router + gateway
    # /health (three sibling subrequests). Nested auth_request cannot do this:
    # auth_request is ignored inside subrequests, so a chained check never
    # probes the gateway. Timeouts live on the internal probe locations.
    location = /health {
        # Bug-9365: complete checked set is model-service, query-router, gateway.
        js_content health_and.servingHealth;
    }

    location = /__health/model {
        internal;
        set $upstream_model ${MODEL_SERVICE_URL};
        proxy_set_header Host ${MODEL_SERVICE_HOST};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
        proxy_pass $upstream_model/health;
    }

    location = /__health/query-router {
        internal;
        set $upstream_router ${QUERY_ROUTER_URL};
        proxy_set_header Host ${QUERY_ROUTER_HOST};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
        proxy_pass $upstream_router/health;
    }

    location = /__health/gateway {
        internal;
        set $upstream_gateway ${GATEWAY_URL};
        proxy_set_header Host ${GATEWAY_HOST};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
        proxy_pass $upstream_gateway/health;
    }

    # Excel plugin SPA
    location /excel-plugin/ {
        try_files $uri $uri/ /excel-plugin/index.html;
    }

    # Static SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Excel plugin custom-functions runtime files are NOT content-hashed:
    # their names never change across builds, so they must revalidate on every
    # load or Office/Excel keeps a stale bundle for a year. Must precede the
    # generic static-asset regex below (first matching regex wins).
    location ~* ^/excel-plugin/(functions\.iife\.js|functions\.html|functions\.json|manifest\.xml)$ {
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location ~* \.(js|css|png|jpg|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}
