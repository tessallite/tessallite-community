# ============================================================
# Tessallite Frontend — copy to .env.local during development
# ============================================================
#
# Every value here is OPTIONAL. When unset, the SPA derives same-host
# URLs from window.location at runtime (so any developer running on
# 127.0.0.1, a LAN IP, or a tunnelled host gets the matching backend
# automatically). Use these only if your services live on a different
# host or non-default ports.

# Vite dev server
# VITE_DEV_SERVER_PORT=5173
# VITE_DEV_PROXY_TARGET=http://localhost:8001

# Backend service base URLs (build-time defaults; runtime cache from
# /api/v1/system/settings can additionally override after auth)
# VITE_API_BASE_URL=http://localhost:8001
# VITE_QUERY_ROUTER_URL=http://localhost:8002
# VITE_OPTIMIZER_URL=http://localhost:8003
# VITE_SCHEDULER_URL=http://localhost:8004
# VITE_GATEWAY_URL=http://localhost:8080
# VITE_GATEWAY_JDBC_HOST=localhost
# VITE_GATEWAY_JDBC_PORT=5433

# Demo tenant one-click login. When all three are set, the login screen
# shows a "Sign in to demo" button that submits these credentials.
# Leave unset in production builds.
# VITE_DEMO_TENANT_SLUG=demo
# VITE_DEMO_EMAIL=admin@demo.com
# VITE_DEMO_PASSWORD=demo
