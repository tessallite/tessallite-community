        }
      ],
      "previous_plan": {
        "query": {
          "model_id": "{{model_id}}",
          "measures": ["base_amount"],
          "dimensions": [],
          "where": [{"name": "business_date", "op": "between", "value": ["2026-04-01", "2026-04-30"]}],
          "having": [],
          "sort": [],
          "limit": 100
        }
      },
      "expect_tool": "query",
      "expect_measures_contain": ["base_amount"],
      "expect_dimensions_contain": ["payment_method"],
      "expect_where_field": "business_date"
    },
    "row_level_where": {
